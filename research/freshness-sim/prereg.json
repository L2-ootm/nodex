    { "id": "H1b", "type": "zero", "arm": "nodex-detached", "metric": "monoViolations",
      "text": "SAFETY: zero version rollbacks within a session",
      "scenarios": ["baseline", "big-audience", "heavy-payload", "small-payload", "high-churn", "hot-writes", "long-tail", "adversarial", "clock-replay", "legacy-poll"] },
    { "id": "H1c", "type": "positive", "arm": "p2p-gossip", "metric": "violations",
      "text": "ABLATION: the same mesh WITHOUT the signed validity window does violate the bound (the oracle has teeth)",
      "scenarios": ["baseline", "adversarial", "clock-replay"] },
    { "id": "H1d", "type": "positive", "arm": "nodex-coupled", "metric": "violations",
      "text": "FINDING: the proof check as coded (raw Date.now, publisher-proof.ts:80) is breakable by replay against slow-clock readers",
