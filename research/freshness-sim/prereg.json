    { "id": "H1f", "type": "positive", "arm": "cdn-ttl", "metric": "violations",
      "text": "BASELINE: TTL=delta CDN violates the bound under serve-stale-on-error (10% failed revalidations); it is safe only while the edge is trusted and healthy",
