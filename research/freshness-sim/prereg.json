    { "id": "H2a", "type": "ratio_le", "arm": "nodex-detached", "vs": "cdn-ttl", "metric": "billedBytes", "max": 0.4,
      "text": "EFFICIENCY: detached proofs cut billed infrastructure bytes to <= 40% of a TTL=delta CDN at the same staleness bound",
      "scenarios": ["baseline", "big-audience", "heavy-payload", "hot-writes"] },
    { "id": "H2b", "type": "ratio_le", "arm": "nodex-detached", "vs": "cdn-ttl", "metric": "billedBytes", "max": 0.75,
      "text": "EFFICIENCY under stress: still <= 75% with 30 s mean sessions or 30% hostile peers",
      "scenarios": ["high-churn", "adversarial"] },
    { "id": "H2c", "type": "max", "arm": "nodex-detached", "metric": "latP95", "max": 150,
      "text": "LATENCY: modelled p95 read latency <= 150 ms (no SLO bought with dropped requests)",
      "scenarios": ["baseline", "big-audience"] },
    { "id": "H2d", "type": "max", "arm": "nodex-detached", "metric": "peerMiBPerRh", "max": 16,
      "text": "USER COST: peer upload+control <= 16 MiB per reader-hour at 64 KiB payloads",
      "scenarios": ["baseline", "big-audience"] },
    { "id": "H3a", "type": "ratio_ge", "arm": "nodex-coupled", "vs": "cdn-ttl", "metric": "billedBytes", "min": 0.7,
      "text": "CUT: the proof-per-GET design in the repo saves < 30% of billed bytes vs a TTL=delta CDN",
      "scenarios": ["baseline", "big-audience", "heavy-payload"] },
    { "id": "H3b", "type": "ratio_ge", "arm": "nodex-coupled", "vs": "nodex-detached", "metric": "peerMiBPerRh", "min": 3,
      "text": "CUT: and it moves >= 3x more bytes onto reader uplinks than the detached design",
      "scenarios": ["baseline", "big-audience", "heavy-payload"] },
    { "id": "H4a", "type": "ratio_ge", "arm": "nodex-detached", "vs": "cdn-ttl", "metric": "usd", "min": 1,
      "text": "KILL ZONE: at hypothetical prices Nodex costs MORE than the TTL CDN for <= 64 KiB snapshots, long tails and short sessions; it must self-disable there",
      "scenarios": ["baseline", "small-payload", "long-tail", "high-churn", "legacy-poll"] },
    { "id": "H4b", "type": "ratio_le", "arm": "nodex-detached", "vs": "cdn-ttl", "metric": "usd", "max": 0.7,
      "text": "WIN ZONE: modelled cost <= 70% of the TTL CDN once payload reaches 1 MiB per version",
      "scenarios": ["heavy-payload"] },
    { "id": "H5", "type": "ratio_ge", "arm": "nodex-detached", "vs": "cdn-ttl", "metric": "originReqs", "min": 1,
