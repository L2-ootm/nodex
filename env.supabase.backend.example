# Nodex Supabase backend env
# Project: nodex-beta-api

NODEX_BETA_STORAGE_DRIVER=supabase
NODEX_SEQUENCE_DRIVER=supabase

# Supabase project settings
SUPABASE_URL=https://tisgenigqnytqbryapzf.supabase.co

# Prefer the newer Supabase secret key when available.
# Keep this server-side only; never expose it with VITE_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Server-assigned tenant UUID for the current beta deployment. Never derive
# this value from an untrusted request header or body.
NODEX_TENANT_ID=00000000-0000-4000-8000-000000000000

# Durable invalidation delivery. Run `npm run outbox:worker` in a long-lived
# process; do not run the polling loop inside a request-scoped serverless function.
NODEX_BETA_SIGNALING_HTTP_URL=https://nodex-signal.example.com
NODEX_SIGNALING_SEED_TOKEN=replace-with-at-least-32-random-bytes

# Stable per worker process. Multiple workers may share a tenant, but each must
# have a distinct UUID. If omitted, a fresh UUID is generated on process start.
# NODEX_OUTBOX_WORKER_ID=00000000-0000-4000-8000-000000000001
# NODEX_OUTBOX_POLL_MS=1000

# Legacy fallback if the project still uses JWT service-role keys.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Existing beta access controls
NODEX_BETA_ADMIN_TOKENS=nodex-admin-REPLACE_ME
NODEX_BETA_TOKENS=nodex-tester-REPLACE_ME|Tester Name|tester@example.com|Personal welcome note

NODEX_BETA_APP_ORIGIN=https://nodex-beta.vercel.app
NODEX_BETA_ALLOWED_ORIGINS=https://nodex-beta.vercel.app

# Supabase Realtime may carry WebRTC negotiation. Durable invalidation outbox
# delivery currently targets the authenticated HTTP signaling seed endpoint.
NODEX_SIGNALING_DRIVER=supabase-realtime
