# Nodex Supabase backend env
# Project: nodex-beta-api

NODEX_BETA_STORAGE_DRIVER=supabase

# Supabase project settings
SUPABASE_URL=https://tisgenigqnytqbryapzf.supabase.co

# Prefer the newer Supabase secret key when available.
# Keep this server-side only; never expose it with VITE_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Legacy fallback if the project still uses JWT service-role keys.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Existing beta access controls
NODEX_BETA_ADMIN_TOKENS=nodex-admin-REPLACE_ME
NODEX_BETA_TOKENS=nodex-tester-REPLACE_ME|Tester Name|tester@example.com|Personal welcome note

NODEX_BETA_APP_ORIGIN=https://nodex-beta.vercel.app
NODEX_BETA_ALLOWED_ORIGINS=https://nodex-beta.vercel.app

# Supabase Realtime replaces Railway/Fly/Render for WebRTC signaling.
NODEX_SIGNALING_DRIVER=supabase-realtime
