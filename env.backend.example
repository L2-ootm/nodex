# Nodex Beta API — Environment Variables
# Project: nodex-beta-api  →  https://nodex-beta-api.vercel.app
#
# Where to set these:
#   Vercel dashboard → nodex-beta-api → Settings → Environment Variables
#   Apply to: Production + Preview (and optionally Development)
#
# How to generate tokens (run in any terminal):
#   node -e "console.log('nodex-tester-' + require('crypto').randomUUID().replace(/-/g,''))"
#   node -e "console.log('nodex-admin-'  + require('crypto').randomUUID().replace(/-/g,''))"
#
# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Comma-separated tester invite tokens.
# Each entry is: token|Name|email|welcomeNote  (pipe-separated, all fields optional after token)
# The name pre-fills the tester's profile form and personalizes the welcome heading.
# The welcome note appears as a callout below the heading after sign-in.
# Example with metadata:
#   nodex-tester-abc|Alice|alice@example.com|Hey Alice, thanks for testing!
# Example without metadata (token only):
#   nodex-tester-abc
NODEX_BETA_TOKENS=nodex-tester-REPLACE_ME_1|Name1||Welcome note for tester 1,nodex-tester-REPLACE_ME_2|Name2||Welcome note for tester 2

# Comma-separated admin tokens.
# Admin tokens unlock: token creation, simulated run control, logs, and ledger export.
# Keep these private — share only with yourself or co-investigators.
NODEX_BETA_ADMIN_TOKENS=nodex-admin-REPLACE_ME

# Deployed frontend URL — no trailing slash.
# Used for CORS validation and for building the test-room URL sent to testers.
# Must match exactly the URL where nodex-beta is deployed.
NODEX_BETA_APP_ORIGIN=https://nodex-beta.vercel.app

# ── VERCEL BLOB STORAGE ───────────────────────────────────────────────────────
#
# Without this token, participant and evidence data is written to /tmp on the
# serverless function instance and will be lost on cold starts or redeployments.
# Set this for any real beta run where you need durable records.
#
# How to get it:
#   1. Vercel dashboard → Storage → Create Database → Blob
#   2. Name it nodex-beta-store (or anything)
#   3. Go to the store → Settings → Tokens → Create token (Read & Write)
#   4. Paste the token value below
BLOB_READ_WRITE_TOKEN=vercelblob_rw_REPLACE_ME

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# WebRTC signaling server WebSocket URL (wss:// for production).
# Required only for real P2P test sessions between testers on different machines.
# Simulated/admin runs do not need a live signaling server.
#
# IMPORTANT: Vercel serverless functions do not support persistent WebSocket
# servers. The signaling server must be deployed separately on a platform
# that supports long-lived connections: Railway, Fly.io, Render, or a VPS.
#
# To deploy the signaling server:
#   npm run server         ← starts locally on ws://localhost:3002/ws
#   Deploy src/server/signaling-server.ts to Railway/Fly with Node.js runtime
#   Then set this to wss://your-signaling-server.example.com/ws
#
# Leave unset to use the localhost default (local dev only).
# NODEX_BETA_SIGNALING_URL=wss://your-signaling-server.example.com/ws

# Comma-separated allowed CORS origins.
# Defaults to NODEX_BETA_APP_ORIGIN if unset.
# Add Vercel preview URLs if you need CORS to work on preview deployments too.
# NODEX_BETA_ALLOWED_ORIGINS=https://nodex-beta.vercel.app,https://preview-domain.example

# Local data directory fallback (used when BLOB_READ_WRITE_TOKEN is absent).
# On Vercel serverless, this is always /tmp — override only for local beta:server runs.
# NODEX_BETA_DATA_DIR=beta-data

# Port for local beta:server (npm run beta:server). Not used on Vercel.
# NODEX_BETA_PORT=3003
