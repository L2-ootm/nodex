{
  "name": "nodex",
  "version": "0.1.0",
  "type": "module",
  "description": "P2P distributed dynamic cache network with browser nodes as encrypted Service Worker peers",
  "scripts": {
    "dev": "concurrently --prefix \"[{name}]\" --names \"server,vite\" \"npm run server\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "server": "tsx src/server/mock-api.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "vitest run && playwright test --project=chromium"
  },
  "dependencies": {
    "@hono/node-server": "2.0.3",
    "hono": "4.12.19",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^25.9.0",
    "@types/serviceworker": "0.0.197",
    "concurrently": "9.2.1",
    "tsx": "latest",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.6"
  }
}
