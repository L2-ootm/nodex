# Defaults support npm run beta:local without a hosted database.
NEXT_PUBLIC_NODEX_BETA_API_URL=http://localhost:3003
NODEX_BETA_APP_ORIGIN=http://localhost:4174
NODEX_BETA_PORT=3003

# API + worker only. Generate private values with npm run keys:generate.
# NODE_ENV=production
# NODEX_SEQUENCE_DRIVER=supabase
# NODEX_BETA_STORAGE_DRIVER=supabase
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SECRET_KEY=<server secret>
# NODEX_TENANT_ID=<UUID>
# NODEX_PUBLISHER_EPOCH=authority-1
# NODEX_PUBLISHER_PRIVATE_JWK=<private P-256 JWK>
# NODEX_SESSION_KEY_HEX=<64 hex characters>
# NODEX_SIGNALING_SEED_TOKEN=<32+ characters>
# NODEX_BETA_ADMIN_TOKENS=<32+ characters>
# NODEX_BETA_TOKENS=<optional environment invitations>
# NODEX_BETA_ALLOWED_ORIGINS=https://APP.example
# NODEX_BETA_APP_ORIGIN=https://APP.example
# NODEX_BETA_SIGNALING_URL=https://API.example/api/signal
# NODEX_BETA_SIGNALING_HTTP_URL=https://API.example/api/signal
# NODEX_OUTBOX_POLL_MS=1000
# TURN credentials are optional. Without TURN, relay-dependent peers fall back to origin.
# NODEX_TURN_URLS=turn:TURN.example:3478
# NODEX_TURN_SHARED_SECRET=<coturn REST secret; 32+ characters>
