{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts", "../shared/**/*.ts", "../crypto/**/*.ts"],
  "exclude": ["**/*.test.ts", "../shared/**/*.test.ts", "../crypto/**/*.test.ts", "node_modules", "dist"]
}
